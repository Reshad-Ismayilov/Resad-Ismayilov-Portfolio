# Meta WhatsApp Business Cloud API

# 1. Meta Developers-dən (developers.facebook.com) WhatsApp Business hesabı yarat,
#    Access Token al ve buraya yaz:
WHATSAPP_ACCESS_TOKEN=

# 2. WhatsApp Business hesabin icinde Phone Number ID-i al ve buraya yaz:
WHATSAPP_PHONE_NUMBER_ID=

# 3. Sifarisin geleceyi whatsapp nomren (sensin). Format: olke kodu + nomre, + isaresiz,
#    Sizin nomreniz: 077 557 01 23  ->  994775570123
WHATSAPP_RECIPIENT_PHONE=994775570123
